api.modc2.com {
    @cors_preflight method OPTIONS

    header Access-Control-Allow-Origin "https://modc2.com"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Accept, Authorization, token"
    header Access-Control-Max-Age "3600"

    handle @cors_preflight {
        respond 204
    }

    handle /bridge/* {
        uri strip_prefix /bridge
        reverse_proxy {$PM2_HOST:localhost}:8840
    }

    handle /* {
        reverse_proxy {$PM2_HOST:localhost}:8000
    }
}

:3000 {
    # Default landing — claude is the canonical control-plane module.
    # Using a 302 (not 301) so we can flip the default later without
    # fighting browser cache. The exact-path matcher means /claude,
    # /api/*, etc. are untouched.
    @root path /
    redir @root /claude 302

    # Core mod-protocol api (FastAPI on :8000) — mounted at /api so the
    # claude UI (and any other module's UI) can call mod core directly
    # without going through host.docker.internal.
    @mod_api path /api/mod /api/mod/*
    handle @mod_api {
        uri strip_prefix /api/mod
        reverse_proxy mod-api:8000
    }

    @claude_api path /api/claude /api/claude/*
    handle @claude_api {
        uri strip_prefix /api/claude
        reverse_proxy claude:8820
    }
    @claude_app path /claude /claude/*
    handle @claude_app {
        reverse_proxy claude:8823
    }
    # Single `polymarket` container runs both the Rust API and the Next.js
    # app in dev mode (source is volume-mounted, hot-reloads on edit).
    @polymarket_api path /api/polymarket /api/polymarket/*
    handle @polymarket_api {
        uri strip_prefix /api/polymarket
        reverse_proxy polymarket:50091
    }
    # CLOB L2 passthrough — browser can hit clob.polymarket.com under CORS,
    # but proxying keeps origin checks predictable and matches the dev script.
    @polymarket_l2 path /api/polymarket-l2 /api/polymarket-l2/*
    handle @polymarket_l2 {
        uri strip_prefix /api/polymarket-l2
        reverse_proxy https://clob.polymarket.com {
            header_up Host clob.polymarket.com
        }
    }
    @polymarket_app path /polymarket/QmTdqSNwtTavaPQcjKPZxEridBZZ6iGQZZHs21fBuc2tr5 /polymarket/QmTdqSNwtTavaPQcjKPZxEridBZZ6iGQZZHs21fBuc2tr5/*
    handle @polymarket_app {
        uri replace /polymarket/QmTdqSNwtTavaPQcjKPZxEridBZZ6iGQZZHs21fBuc2tr5 /polymarket 1
        reverse_proxy polymarket:3091
    }
    # Hyperliquid runs on the host under pm2 (not a docker container) — see
    # `m.mod('hyperliquid')().serve()`. Routes have to live inside :3000
    # explicitly because the catch-all below forwards everything else to
    # polymarket, and the `module_routes` snippet isn't imported in this block.
    @hyperliquid_api path /api/hyperliquid /api/hyperliquid/*
    handle @hyperliquid_api {
        uri strip_prefix /api/hyperliquid
        reverse_proxy host.docker.internal:8919
    }
    @hyperliquid_app path /hyperliquid /hyperliquid/*
    handle @hyperliquid_app {
        reverse_proxy host.docker.internal:3919
    }

    # copytensor — same pattern as hyperliquid. Can run on the host (PM-style)
    # or as a docker container on modnet. When the container is healthy it
    # answers on copytensor:50150/3150; when running locally on the host it
    # answers via host.docker.internal. We point at host.docker.internal so
    # both modes work without a Caddyfile rewrite.
    @copytensor_api_3000 path /api/copytensor /api/copytensor/*
    handle @copytensor_api_3000 {
        uri strip_prefix /api/copytensor
        reverse_proxy host.docker.internal:50150
    }
    @copytensor_app_3000 path /copytensor /copytensor/*
    handle @copytensor_app_3000 {
        reverse_proxy host.docker.internal:3150
    }

    @localfs_api_3000 path /api/localfs /api/localfs/*
    handle @localfs_api_3000 {
        uri strip_prefix /api/localfs
        reverse_proxy host.docker.internal:8860
    }
    @localfs_app_3000 path /localfs /localfs/*
    handle @localfs_app_3000 {
        uri strip_prefix /localfs
        reverse_proxy host.docker.internal:8861
    }

    handle /* {
        reverse_proxy polymarket:3091
    }
}

