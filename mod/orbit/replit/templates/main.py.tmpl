#!/usr/bin/env python3
"""Serve this module the way the mod protocol does.

POST /{fn}          call a function (JSON body = kwargs) -> {"result": ...}
POST /mod/__NAME__  null call -> module info
GET  /health        liveness, plus the import error if the module did not load
GET  /              info as JSON

Generated by the mod protocol's `replit` module. Stdlib only.
"""
import importlib.util
import inspect
import json
import os
import sys
import traceback
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))
ANCHOR = os.path.join(HERE, '__ANCHOR__')
NAME = '__NAME__'
PORT = int(os.environ.get('PORT', 8080))

instance, load_error = None, None
try:
    sys.path.insert(0, HERE)
    spec = importlib.util.spec_from_file_location('_mod_anchor', ANCHOR)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    cls = getattr(module, 'Mod', None)
    if cls is None:
        raise AttributeError('no class Mod in ' + ANCHOR)
    instance = cls()
except Exception:
    load_error = traceback.format_exc(limit=6)


def fns():
    if instance is None:
        return []
    return sorted(n for n, _ in inspect.getmembers(instance, callable)
                  if not n.startswith('_'))


def params():
    """{fn: [{name, required, default}]} — what a caller may pass. The bridge
    turns this into typed tools on the other side, so report it on every info."""
    out = {}
    skip = (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD)
    for n in fns():
        try:
            sig = inspect.signature(getattr(instance, n))
        except (TypeError, ValueError):
            continue
        row = []
        for p in sig.parameters.values():
            if p.kind in skip:
                continue
            d = None if p.default is inspect.Parameter.empty else p.default
            if not isinstance(d, (str, int, float, bool, list, dict, type(None))):
                d = str(d)
            row.append({'name': p.name, 'default': d,
                        'required': p.default is inspect.Parameter.empty})
        out[n] = row
    return out


def docs():
    """{fn: first line of its docstring} — one line is what a tool list shows."""
    out = {}
    for n in fns():
        d = (inspect.getdoc(getattr(instance, n)) or '').strip()
        if d:
            out[n] = d.split('\n')[0][:200]
    return out


def info():
    return {'name': NAME, 'description': getattr(instance, 'description', ''),
            'fns': fns(), 'params': params(), 'docs': docs(),
            'loaded': instance is not None,
            'error': load_error, 'host': 'replit'}


class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *a):
        pass

    def _send(self, code, body):
        data = json.dumps(body, default=str).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(data)

    def do_GET(self):
        path = self.path.split('?')[0]
        if path == '/health':
            return self._send(200 if instance is not None else 503,
                              {'ok': instance is not None, 'mod': NAME,
                               'error': load_error})
        return self._send(200, info())

    def do_POST(self):
        path = self.path.split('?')[0].rstrip('/') or '/'
        try:
            n = int(self.headers.get('Content-Length') or 0)
            kwargs = json.loads(self.rfile.read(n) or b'{}')
        except ValueError as e:
            return self._send(400, {'error': 'bad json: %s' % e})
        if not isinstance(kwargs, dict):
            return self._send(400, {'error': 'body must be a JSON object'})
        if path in ('/', '/mod/' + NAME) and not kwargs:
            return self._send(200, info())
        if instance is None:
            return self._send(503, {'error': 'module did not load',
                                    'traceback': load_error})
        fn = path.rsplit('/', 1)[-1]
        if fn not in fns():
            return self._send(404, {'error': 'no fn %r' % fn, 'fns': fns()})
        try:
            return self._send(200, {'result': getattr(instance, fn)(**kwargs)})
        except TypeError as e:
            return self._send(400, {'error': str(e)})
        except Exception as e:
            return self._send(500, {'error': str(e),
                                    'traceback': traceback.format_exc(limit=4)})


if __name__ == '__main__':
    print('%s on :%d (loaded=%s)' % (NAME, PORT, instance is not None), flush=True)
    ThreadingHTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
