{
  "_doc": "Single provider registry for the model gateway. Read by app/catalog.py (FastAPI server + mod.py CLI) and api/src/main.rs (Rust). Every provider speaks OpenAI-compatible /chat/completions; models_auth/models_headers/models_query only cover the /models listing quirks. models_query widens a listing to every model TYPE (OpenRouter and Venice list only text models by default). group: lab | router | network (decentralized) — sidebar grouping only. Models whose provider declares api_shapes without chat.completions are bridged to OpenAI format by app/adapters.py.",
  "providers": [
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "group": "router",
      "url": "https://openrouter.ai/api/v1",
      "default_model": "anthropic/claude-sonnet-5",
      "key_hint": "sk-or-…",
      "docs": "https://openrouter.ai/keys",
      "env": "OPENROUTER_API_KEY",
      "public_models": true,
      "models_query": "output_modalities=all"
    },
