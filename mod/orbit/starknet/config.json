{
    "name": "starknet",
    "version": "0.3.0",
    "description": "Starknet explorer app + API, one port. The app: live blocks, transactions, wallets, any contract read through its own on-chain ABI, and the STRK20 privacy pool's public side. The API: JSON-RPC reads over a failover pool of free public endpoints (your node first via STARKNET_RPC), Cairo ABI codec, STRK20 pool tools, and 20 MCP tools over stdio and POST /mcp. Backend is Python stdlib only.",
    "icon": "S",
    "anchor": "mod.py",
    "port": 51020,
    "app_port": 51020,
    "base_path": "/starknet",
    "route": true,
    "urls": {
        "api": "http://localhost:51020",
        "app": "http://localhost:51020/starknet",
        "explorer": "https://voyager.online",
        "mcp": "http://localhost:51020/mcp",
        "strk20_docs": "https://strk20.starknet.io/docs",
        "app_api": "http://localhost:51020/starknet/_api"
    },
    "networks": {
        "mainnet": "https://starknet-rpc.publicnode.com",
        "sepolia": "https://starknet-sepolia-rpc.publicnode.com"
    },
    "endpoints": {
        "info": "GET /",
        "health": "GET /health",
        "status": "GET /status?network=",
        "block_number": "GET /block_number",
        "blocks": "GET /blocks?limit=",
        "search": "GET /search?q=  (block number | tx | block hash | address | token alias)",
        "block": "GET /block?id=latest|<n>|<hash>&full=1",
        "tx": "GET /tx?hash=",
        "receipt": "GET /receipt?hash=",
        "account": "GET /account?address=",
        "balance": "GET /balance?address=&token=eth|strk|usdc|0x..",
        "nonce": "GET /nonce?address=",
        "class_hash": "GET /class_hash?address=",
        "storage": "GET /storage?address=&key=",
        "selector": "GET /selector?name=",
        "call": "GET|POST /call {contract, entrypoint|selector, calldata}",
        "rpc": "POST /rpc {method, params}",
        "contract": "GET /contract?address=",
        "read": "GET|POST /read {contract, function, args}",
        "encode": "GET|POST /encode {contract, function, args}",
        "events": "GET /events?address=&name=&limit=",
        "strk20_pool": "GET /strk20/pool",
        "strk20_activity": "GET /strk20/activity?event=&limit=",
        "strk20_user": "GET /strk20/user?address=",
        "strk20_note": "GET /strk20/note?id=",
        "strk20_nullifier": "GET /strk20/nullifier?value=",
        "strk20_helpers": "GET /strk20/helpers",
        "strk20_helper": "GET /strk20/helper?address=",
        "strk20_invoke_action": "POST /strk20/invoke_action {helper, args}",
        "strk20_docs": "GET /strk20/docs?page=&q=",
        "mcp": "POST /mcp",
        "tools": "GET /tools \u00b7 POST /tools/<name>",
        "app": "GET /starknet/  (pages: /, /block?n=, /tx?h=, /address?a=, /privacy, /developers)"
    },
    "fns": [
        "info",
        "forward",
        "status",
        "chain_id",
        "block_number",
        "blocks",
        "search",
        "block",
        "tx",
        "receipt",
        "account",
        "balance",
        "nonce",
        "class_hash",
        "storage",
        "call",
        "selector",
        "rpc",
        "contract",
        "read",
        "encode",
        "events",
        "strk20_pool",
        "strk20_activity",
        "strk20_user",
        "strk20_note",
        "strk20_nullifier",
        "strk20_helpers",
        "strk20_helper",
        "strk20_invoke_action",
        "strk20_docs",
        "mcp",
        "tools",
        "build",
        "serve",
        "kill",
        "test",
        "readme"
    ],
    "backend": "python stdlib only (http.server + urllib) in api/; keccak-256 and starknet_keccak in-tree; Cairo ABI codec in-tree (api/abi.py); MCP server in-tree (api/mcp.py). App: Next 14 static export in app/, no node process at runtime.",
    "auth": "read-only \u2014 no keys are held, nothing to leak. STRK20 private transactions need the user's viewing key and a STARK proof; this module encodes actions (strk20_invoke_action) but never asks for a viewing key, proves, signs or submits.",
    "env": {
        "PORT": "port for API and console (default 51020)",
        "STARKNET_NETWORK": "default network (mainnet)",
        "STARKNET_RPC": "your own node \u2014 always tried first, no third party contacted if it answers",
        "STARKNET_TIMEOUT": "per-endpoint RPC timeout in seconds (default 15)",
        "STRK20_POOL": "override the STRK20 pool address (STRK20_POOL_SEPOLIA for sepolia, none is built in)",
        "STARKNET_ABI_CACHE": "where class ABIs are cached by class hash (default ~/.mod/starknet/abi)"
    },
    "schema": "QmYWtxtnkhkxo2rwpBWq2pw5UkmzzVajGPtPuuLfy5kJtz",
    "mcp": {
        "endpoint": "POST /mcp",
        "transport": "Streamable HTTP (JSON-RPC 2.0)",
        "stdio": "python3 api/mcp.py",
        "tools": [
            "starknet_status",
            "starknet_block",
            "starknet_tx",
            "starknet_account",
            "starknet_balance",
            "starknet_contract",
            "starknet_read",
            "starknet_encode",
            "starknet_events",
            "starknet_storage",
            "starknet_rpc",
            "strk20_pool",
            "strk20_activity",
            "strk20_user",
            "strk20_note",
            "strk20_nullifier",
            "strk20_helpers",
            "strk20_helper",
            "strk20_invoke_action",
            "strk20_docs"
        ]
    },
    "mcp_port": 51020,
    "contracts": {
        "mainnet": {
            "strk20_pool": "0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a"
        }
    },
    "layout": {
        "api": "api/ \u2014 api.py (server), chain.py, abi.py, strk20.py, mcp.py (python stdlib)",
        "app": "app/ \u2014 Next.js static export, built by app/build.sh into app/dist, served by api/api.py"
    }
}