{
    "anchor": "src/mod.py",
    "app_port": 3150,
    "archive_pool_size": 6,
    "auto_discover": true,
    "bt_mirror_max": 25,
    "bt_url": "http://localhost:50280",
    "cooldown_sec": 60,
    "daily_limit_tao": 100.0,
    "description": "Bittensor dTAO copy trading \u2014 mirror subnet allocations of top performers; reads served by the bt module's local index (public RPCs as fallback)",
    "endpoints": {
        "/account/{ss58}": {
            "docs": "Coldkey allocations + N-day PnL",
            "method": "GET"
        },
        "/account/{ss58}/curve": {
            "docs": "Equity/PnL curve from local snapshots, with inferred trades pinned to the curve (?days=7)",
            "method": "GET"
        },
        "/account/{ss58}/pnl": {
            "docs": "Detailed PnL breakdown by subnet",
            "method": "GET"
        },
        "/copies": {
            "docs": "List active copy configs",
            "method": "GET"
        },
        "/copy": {
            "docs": "Create a copy config (target \u2192 our hotkey)",
            "method": "POST"
        },
        "/copy/{id}/pause": {
            "docs": "Pause a copy",
            "method": "POST"
        },
        "/copy/{id}/resume": {
            "docs": "Resume a copy",
            "method": "POST"
        },
        "/copy/{id}/sync": {
            "docs": "Force sync (apply target's allocations now)",
            "method": "POST"
        },
        "/discover": {
            "docs": "Watch top-N of the on-chain universe (?top=8&kind=validator|nominator|all)",
            "method": "POST"
        },
        "/flows": {
            "docs": "Inferred trade tape across every tracked trader",
            "method": "GET"
        },
        "/health": {
            "docs": "Chain health + active RPC + full pool",
            "method": "GET"
        },
        "/leaderboard": {
            "docs": "Top performers by N-day alpha PnL (?days=7&top=50)",
            "method": "GET"
        },
        "/market": {
            "docs": "Network totals (alpha market cap, 24h volume, block, TAO/USD) + top gainers/losers",
            "method": "GET"
        },
        "/pool": {
            "docs": "Resize the trader pool (?size=250&refresh=false) \u2014 grows in background",
            "method": "POST"
        },
        "/status": {
            "docs": "Running state, block height, tracked accounts, active copies, and which backend serves reads (bt | rpc)",
            "method": "GET"
        },
        "/subnets": {
            "docs": "All subnets, enriched from the bt index (price, 24h/1h change, market cap, volume, sparkline, identity)",
            "method": "GET"
        },
        "/subnets/{netuid}": {
            "docs": "One subnet: pool state, on-chain identity, validator rankings",
            "method": "GET"
        },
        "/subnets/{netuid}/history": {
            "docs": "Indexed price/mcap/volume series for a subnet (?hours=168)",
            "method": "GET"
        },
        "/tao_price": {
            "docs": "TAO/USD price (coingecko, 5-min server cache)",
            "method": "GET"
        },
        "/trader/{ss58}": {
            "docs": "Full trader profile (positions, performance, label)",
            "method": "GET"
        },
        "/traders": {
            "docs": "Tracked traders with value, allocation and windowed PnL (from bt's index)",
            "method": "GET"
        },
        "/traders/{ss58}": {
            "docs": "Indexed profile \u2014 positions, equity curve, inferred trades",
            "method": "GET"
        },
        "/traders/{ss58}/flows": {
            "docs": "One trader's inferred buys/sells",
            "method": "GET"
        },
        "/traders/{ss58}/history": {
            "docs": "Portfolio value over time (free/staked/total)",
            "method": "GET"
        },
        "/trades": {
            "docs": "Copy-engine trade history (?limit=50&copy_id=...)",
            "method": "GET"
        },
        "/universe": {
            "docs": "Trader-pool status: watched vs on-chain universe size, discovery progress",
            "method": "GET"
        },
        "/wallet/balance": {
            "docs": "Current wallet TAO balance",
            "method": "GET"
        },
        "/wallet/set": {
            "docs": "Set wallet (mnemonic or seed_hex) \u2014 only needed to stake",
            "method": "POST"
        },
        "/watch": {
            "docs": "Add coldkey to watch list",
            "method": "POST"
        },
        "/watches": {
            "docs": "List watched coldkeys",
            "method": "GET"
        }
    },
    "fns": [
        "serve",
