{
    "name": "bitevo",
    "version": "2.1.0",
    "description": "Bittensor subnet on the zuma protocol \u2014 anonymous miners pitch YC-style startups, anonymous validators judge them (LSAG ring signatures, wire-compatible with orbit/ztensor's Starknet/NEAR contracts); evolutionary genome populations fit multivariate predictions of the future",
    "port": 51460,
    "app_port": 51461,
    "urls": {
        "api": "http://localhost:51460",
        "app": "http://localhost:51461"
    },
    "fns": [
        "forward",
        "simulate",
        "epoch",
        "leaderboard",
        "results",
        "status",
        "add_miner",
        "challenge",
        "score_idea",
        "evolve",
        "forecast",
        "population",
        "datasets",
        "zuma",
        "audit",
        "backends",
        "whitepaper",
        "test",
        "serve",
        "kill"
    ],
    "endpoints": {
        "/health": {
            "method": "GET",
            "docs": "Health check"
        },
        "/status": {
            "method": "GET",
            "docs": "Module status and leaderboard"
        },
        "/simulate": {
            "method": "POST",
            "docs": "Run local simulation with N miners"
        },
        "/epoch": {
            "method": "POST",
            "docs": "Run a single validation epoch"
        },
        "/leaderboard": {
            "method": "GET",
            "docs": "Miner leaderboard sorted by EMA score"
        },
        "/results": {
            "method": "GET",
            "docs": "Get epoch results (query ?epoch=N)"
        },
        "/miner": {
            "method": "POST",
            "docs": "Add a local miner"
        },
        "/challenge": {
            "method": "GET",
            "docs": "Generate/preview a challenge"
        },
        "/score": {
            "method": "POST",
            "docs": "Score a single startup idea"
        },
        "/evolve": {
            "method": "POST",
            "docs": "Evolve multivariate forecaster genomes against the held-out future window"
        },
        "/forecast": {
            "method": "GET",
            "docs": "Best genome's multivariate forecast (query ?horizon=N)"
        },
        "/population": {
            "method": "GET",
            "docs": "Genome leaderboard and fitness history"
        },
        "/datasets": {
            "method": "GET",
            "docs": "Built-in multivariate datasets for evolution"
        },
        "/backends": {
            "method": "GET",
            "docs": "Supported LLM backends"
        },
        "/whitepaper": {
            "method": "GET",
            "docs": "Bitevo whitepaper (markdown)"
        },
        "/zuma": {
            "method": "GET",
            "docs": "zuma subnet registry: rings, emission, credits per payout"
        },
        "/audit": {
            "method": "GET",
            "docs": "Re-verify every ring signature of an epoch (query ?epoch=N)"
        }
    },
    "schema": "QmWrUZt6EGPoofJaWQFjBWRu4mUoYe9tRKFxMtNdc3GYgJ",
    "gateway_port": 51461,
    "protocol": {
        "name": "zuma",
        "impl": "core/zuma.py (pure Python, imports orbit/ztensor/src/core/stark.py)",
        "submit": "miner LSAG over msg=work in H('zuma-mine', subnet, epoch); tag = key_id(image)",
        "score": "validator LSAG over msg=score 0..100 in H('zuma-score', subnet, epoch, tag); nullifier = key_id(image)",
        "claim": "miner re-signs the mine scope with msg=payout; credited emission*tag_sum/epoch_total",
        "state": "~/.bitevo/zuma/keys.json (0600) + subnet.json"
    }
}