{
    "name": "dev",
    "version": "0.2.0",
    "description": "Modular OpenAI-standard multi-provider LLM gateway \u2014 Rust (axum) backend + Next.js app. Each provider (venice, openrouter, codex, claude, \u2026) is one OpenAI-compatible template; add your own at runtime. BYOK or backend key, SSE streaming, wallet (mod protocol) auth.",
    "port": 8870,
    "app_port": 8871,
    "owner": "0x70f1DB27c2A64cabDd9888dD6C6F27cCBdE6D7C2",
    "icon": "D",
    "color": "#6366f1",
    "image": "https://api.iconify.design/mdi:hub.svg?color=%23ffffff",
    "providers": {
        "venice": {
            "label": "Venice",
            "base_url": "https://api.venice.ai/api/v1",
            "backend_env": "VENICE_API_KEY",
            "default_model": "zai-org-glm-5",
            "icon": "V",
            "color": "#b91c1c",
            "byok": true
        },
        "openrouter": {
            "label": "OpenRouter",
            "base_url": "https://openrouter.ai/api/v1",
            "backend_env": "OPENROUTER_API_KEY",
            "default_model": "openai/gpt-4o-mini",
            "icon": "O",
            "color": "#6467f2",
            "byok": true
        },
        "codex": {
            "label": "OpenAI",
            "base_url": "https://api.openai.com/v1",
            "backend_env": "OPENAI_API_KEY",
            "default_model": "gpt-4o-mini",
            "icon": "C",
            "color": "#10a37f",
            "byok": true
        },
        "claude": {
            "label": "Claude",
            "base_url": "https://api.anthropic.com/v1",
            "backend_env": "ANTHROPIC_API_KEY",
            "default_model": "claude-sonnet-4-6",
            "icon": "A",
            "color": "#d97757",
            "byok": true
        }
    },
    "urls": {
        "api": "http://localhost:8870",
        "app": "http://localhost:8871/dev",
        "gateway": "http://localhost:3000/dev"
    },
    "endpoints": {
        "/health": {
            "method": "GET",
            "docs": "Liveness probe"
        },
        "/providers": {
            "method": "GET",
            "docs": "List configured providers (public, no secrets)"
        },
        "/providers/{name}/models": {
            "method": "GET",
            "docs": "Proxy a provider's model list (Bearer token)"
        },
        "/me": {
            "method": "GET",
            "docs": "Caller identity + per-provider key status (Bearer token)"
        },
        "/key/{provider}": {
            "method": "POST",
            "docs": "Store caller's BYOK key for a provider (Bearer token)"
        },
        "/chat/{provider}": {
            "method": "POST",
            "docs": "OpenAI-style chat completion, SSE streaming (Bearer token)"
        }
    },
    "fns": [
        "forward",
        "serve",
        "serve_api",
        "serve_app",
        "kill",
        "status",
        "health",
        "providers",
        "register",
        "deregister"
    ],
    "schema": "QmWGv85fbu93J6PxGi1omH5omvEGpEkqm6acq5BDvf9r9a"
}