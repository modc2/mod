{
    "name": "lighthouse",
    "description": "Lighthouse Labs perpetual decentralized storage (lighthouse.storage) \u2014 API-key uploads to IPFS/Filecoin with perpetual pinning, gateway retrieval, owner-keyed local index",
    "version": "0.2.0",
    "urls": {
        "api": "https://api.lighthouse.storage",
        "upload": "https://upload.lighthouse.storage/api/v0/add",
        "gateway": "https://gateway.lighthouse.storage",
        "dashboard": "https://files.lighthouse.storage"
    },
    "fns": [
        "put",
        "get",
        "pin",
        "list",
        "rm",
        "status",
        "usage",
        "uploads",
        "set_key",
        "key_status",
        "install"
    ],
    "env": {
        "LIGHTHOUSE_API_KEY": "API key from files.lighthouse.storage (or persist via m lighthouse/set_key)",
        "LIGHTHOUSE_GATEWAY": "Override retrieval gateway (default https://gateway.lighthouse.storage)"
    },
    "credentials": "~/.mod/lighthouse/credentials.json (off-chain, never committed)",
    "schema": "QmegLxzr8TPvs5wrC3uis61bxTTRg5EKKxGt2ocx3xK9Sj"
}