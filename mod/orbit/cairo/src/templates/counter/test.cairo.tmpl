fn deploy() -> I{{NAME}}Dispatcher {
    let contract = declare("{{NAME}}").unwrap().contract_class();
    let (addr, _) = contract.deploy(@array![]).unwrap();
    I{{NAME}}Dispatcher { contract_address: addr }
}

#[test]
fn test_starts_zero() {
