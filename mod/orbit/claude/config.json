{
    "name": "claude",
    "version": "2.1.0",
    "description": "Programmable AI developer interface \u2014 Python SDK, Rust Job Server, Next.js Terminal UI, IPFS versioning",
    "port": 8820,
    "app_port": 8823,
    "owner": "0xD779eB61CEd815570F74AB15a52eE8378a66996f",
    "chain_network": "testnet",
    "bloctime_gate": true,
    "bloctime_ttl": 60,
    "onchain_registry": false,
    "icon": "C",
    "color": "#cc785c",
    "deps": [
        "chain",
        "store"
    ],
    "fns": [
        "forward",
        "ask",
        "analyze_code",
        "generate_code",
        "refactor",
        "debug",
        "edit_file",
        "run_task",
        "batch_process",
        "bg",
        "bg_status",
        "bg_list",
        "submit",
        "create_module",
        "edit_module",
        "jobs",
        "job",
        "cancel",
        "kill",
        "kill_port",
        "module_process",
        "module_status",
        "restart_module",
        "stop_module",
        "start_module",
        "delete_job",
        "tail",
        "snapshot",
        "changelog",
        "show_changelog",
        "get_version",
        "restore_version",
        "get_owner",
        "set_owner",
        "is_owner",
        "is_bloctime_owner",
        "is_trusted",
        "is_whitelisted",
        "editors",
        "add_editor",
        "remove_editor",
        "register_onchain",
        "health",
        "modules",
        "folders",
        "suggest_folders",
        "repos",
        "files",
        "owner",
        "models",
        "serve",
        "test",
        "logs",
        "install",
        "setup",
        "scan",
        "fix"
    ],
    "schema": "QmTSZnUHEjpguuwZmV1g358FV2chitDkJsJpVp475V58pU",
    "endpoints": {
        "/health": {
            "method": "GET",
            "auth": false,
            "docs": "Health check"
        },
        "/config": {
            "method": "GET",
            "auth": false,
            "docs": "Get module config.json"
        },
        "/owner": {
            "method": "GET",
            "auth": false,
            "docs": "Get owner address and status"
        },
        "/repos": {
            "method": "GET",
            "auth": false,
            "docs": "List git repositories"
        },
        "/modules": {
            "method": "GET",
            "auth": false,
            "docs": "List orbit and core modules"
        },
        "/folders": {
            "method": "GET",
            "auth": false,
            "docs": "List folders under a path with optional search filter"
        },
        "/suggest_folders": {
            "method": "GET",
            "auth": false,
            "docs": "Suggest folders using embedcode similarity search"
        },
        "/files/tree": {
            "method": "GET",
            "auth": false,
            "docs": "File tree browser"
        },
        "/jobs": {
            "method": [
                "POST",
                "GET"
            ],
            "auth": true,
            "docs": "Submit or list jobs"
        },
        "/jobs/{id}": {
            "method": [
                "GET",
                "DELETE"
            ],
            "auth": true,
            "docs": "Get or delete job"
        },
        "/jobs/{id}/cancel": {
            "method": "POST",
            "auth": true,
            "docs": "Cancel a running job"
        },
        "/jobs/{id}/stream": {
            "method": "GET",
            "auth": true,
            "docs": "SSE live stream of job output"
        },
        "/kill": {
            "method": "POST",
            "auth": true,
            "sudo": true,
            "docs": "Kill a process by PID or port (owner-only; requires x-sudo signature bound to pid:/port:)"
        },
        "/modules/{name}/process": {
            "method": "POST",
            "auth": true,
            "sudo": "cross-module",
            "docs": "Manage a module's processes \u2014 body {action: status|stop|start|restart, target?: api|app}. Backend is pluggable per module (pm2|systemd|generic) via MOD_PM env or the target module's config.json `process_manager` field (default: auto-detect). Modules shipping a flake.nix/shell.nix get self-launched commands nix-wrapped. Owner-only; status is read-only, and mutating actions on a module other than claude require an x-sudo signature bound to process:{name}. Response includes the resolved `backend` and `nix_env`."
        },
        "/files/write": {
            "method": "POST",
            "auth": true,
            "sudo": "cross-module",
            "docs": "Write a file. Untrusted callers are confined to their workspace; trusted callers (owner + whitelisted editors) may write anywhere under ~/mod (incl. core/+orbit/) with just their bearer session \u2014 no per-write sudo."
        },
        "/modules/{name}": {
            "method": "DELETE",
            "auth": true,
            "sudo": "non-owned",
            "docs": "Delete a module. Editing a module not personally owned by the caller requires an x-sudo signature from the owner key."
        },
        "/modules/{name}/restore": {
            "method": "POST",
            "auth": true,
            "sudo": "non-claude",
            "docs": "Restore a module from a snapshot CID (owner-only; x-sudo required for modules other than claude)."
        },
        "/whitelist": {
            "method": [
                "GET",
                "POST"
            ],
            "auth": "GET: false, POST: true",
            "docs": "List edit-whitelist (GET, public) or add an address (POST, owner-only). Whitelisted addresses are trusted editors: owner-level EDIT access to the orbit (host filesystem, unsandboxed jobs, core/+orbit/ writes), but NOT owner-only powers (whitelist mgmt, set_owner, kill, delete/rename/restore). Stored off-tree in ~/.mod/claude/whitelist.json."
        },
        "/whitelist/{address}": {
            "method": "DELETE",
            "auth": true,
            "docs": "Remove an address from the edit whitelist (owner-only)."
        },
        "/changelog": {
            "method": "GET",
            "auth": false,
            "docs": "Get version changelog"
        },
        "/versions/{version}": {
            "method": "GET",
            "auth": false,
            "docs": "Get a specific version entry"
        }
    },
    "urls": {
        "api": "http://localhost:8820",
        "app": "http://localhost:8823"
    },
    "gateway_port": 3000
}