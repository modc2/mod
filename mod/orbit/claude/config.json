{
    "name": "claude",
    "version": "2.1.0",
    "description": "Programmable AI developer interface \u2014 Python SDK, Rust Job Server, Next.js Terminal UI, IPFS versioning",
    "port": 8820,
    "app_port": 8823,
    "owner": "0x70f1DB27c2A64cabDd9888dD6C6F27cCBdE6D7C2",
    "chain_network": "testnet",
    "bloctime_gate": true,
    "bloctime_ttl": 60,
    "onchain_registry": false,
    "icon": "C",
    "color": "#cc785c",
    "fns": [
        "forward",
        "ask",
        "analyze_code",
        "generate_code",
        "refactor",
        "debug",
        "edit_file",
        "run_task",
        "batch_process",
        "bg",
        "bg_status",
        "bg_list",
        "submit",
        "create_module",
        "edit_module",
        "jobs",
        "job",
        "cancel",
        "kill",
        "kill_port",
        "delete_job",
        "tail",
        "snapshot",
        "changelog",
        "show_changelog",
        "get_version",
        "restore_version",
        "get_owner",
        "set_owner",
        "is_owner",
        "is_bloctime_owner",
        "register_onchain",
        "health",
        "modules",
        "folders",
        "suggest_folders",
        "repos",
        "files",
        "owner",
        "models",
        "serve",
        "test",
        "logs",
        "install",
        "setup",
        "scan",
        "fix"
    ],
    "schema": "QmafHQNRd5NjjX6tk5XuLoBur62bVErZW7Jot4DMPYBizJ",
    "endpoints": {
        "/health": {
            "method": "GET",
            "auth": false,
            "docs": "Health check"
        },
        "/config": {
            "method": "GET",
            "auth": false,
            "docs": "Get module config.json"
        },
        "/owner": {
            "method": "GET",
            "auth": false,
            "docs": "Get owner address and status"
        },
        "/repos": {
            "method": "GET",
            "auth": false,
            "docs": "List git repositories"
        },
        "/modules": {
            "method": "GET",
            "auth": false,
            "docs": "List orbit and core modules"
        },
        "/folders": {
            "method": "GET",
            "auth": false,
            "docs": "List folders under a path with optional search filter"
        },
        "/suggest_folders": {
            "method": "GET",
            "auth": false,
            "docs": "Suggest folders using embedcode similarity search"
        },
        "/files/tree": {
            "method": "GET",
            "auth": false,
            "docs": "File tree browser"
        },
        "/jobs": {
            "method": [
                "POST",
                "GET"
            ],
            "auth": true,
            "docs": "Submit or list jobs"
        },
        "/jobs/{id}": {
            "method": [
                "GET",
                "DELETE"
            ],
            "auth": true,
            "docs": "Get or delete job"
        },
        "/jobs/{id}/cancel": {
            "method": "POST",
            "auth": true,
            "docs": "Cancel a running job"
        },
        "/jobs/{id}/stream": {
            "method": "GET",
            "auth": true,
            "docs": "SSE live stream of job output"
        },
        "/kill": {
            "method": "POST",
            "auth": true,
            "sudo": true,
            "docs": "Kill a process by PID or port (owner-only; requires x-sudo signature bound to pid:/port:)"
        },
        "/files/write": {
            "method": "POST",
            "auth": true,
            "sudo": "cross-module",
            "docs": "Write a file. Non-owners are confined to their workspace; owner writes OUTSIDE the claude module require an x-sudo signature bound to the path."
        },
        "/modules/{name}": {
            "method": "DELETE",
            "auth": true,
            "sudo": "non-owned",
            "docs": "Delete a module. Editing a module not personally owned by the caller requires an x-sudo signature from the owner key."
        },
        "/modules/{name}/restore": {
            "method": "POST",
            "auth": true,
            "sudo": "non-claude",
            "docs": "Restore a module from a snapshot CID (owner-only; x-sudo required for modules other than claude)."
        },
        "/changelog": {
            "method": "GET",
            "auth": false,
            "docs": "Get version changelog"
        },
        "/versions/{version}": {
            "method": "GET",
            "auth": false,
            "docs": "Get a specific version entry"
        }
    },
    "urls": {
        "api": "http://localhost:8820",
        "app": "http://localhost:8823"
    },
    "gateway_port": 3000
}