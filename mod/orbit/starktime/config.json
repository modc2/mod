{
    "name": "starktime",
    "description": "StakeTime for Starknet. Lock STRK for time: weight = amount x lock multiplier (1x flexible to 6x at four years), rewards stream every second pro-rata by weight, expired locks lapse back to 1x. Rust (axum) API serving a Next.js app, plus a Cairo 2 contract with the same math. Paper ledger until the contract is deployed; live Starknet reads (chain head, native staking totals, balances).",
    "version": "0.1.0",
    "anchor": "mod.py",
    "port": 51280,
    "app_port": 51280,
    "route": true,
    "urls": {
        "api": "http://localhost:51280",
        "app": "http://localhost:51280/starktime"
    },
    "contract": {
        "network": "sepolia",
        "address": null,
        "token": "0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d"
    },
    "endpoints": {
        "health": {
            "method": "GET",
            "auth": false,
            "docs": "Liveness"
        },
        "info": {
            "method": "GET",
            "auth": false,
            "docs": "Module + contract status"
        },
        "params": {
            "method": "GET",
            "auth": false,
            "docs": "Protocol params: curve, emission, max lock"
        },
        "quote": {
            "method": "GET",
            "auth": false,
            "docs": "{amount, lock_seconds|lock_days} -> {multiplier, weight, share, daily_reward, apr_while_locked}"
        },
        "curve": {
            "method": "GET",
            "auth": false,
            "docs": "{samples} -> sampled lock multiplier curve"
        },
        "emissions": {
            "method": "GET",
            "auth": false,
            "docs": "{epochs} -> per-epoch emission schedule"
        },
        "stats": {
            "method": "GET",
            "auth": false,
            "docs": "Pool totals: staked, weight, emission, APR, stakers"
        },
        "account": {
            "method": "GET",
            "auth": false,
            "docs": "{owner} -> paper wallet, positions, pending rewards"
        },
        "positions": {
            "method": "GET",
            "auth": false,
            "docs": "All positions by weight (top 200)"
        },
        "leaderboard": {
            "method": "GET",
            "auth": false,
            "docs": "Stakers ranked by weight"
        },
        "validators": {
            "method": "GET",
            "auth": false,
            "docs": "Weight grouped by validator tag"
        },
        "history": {
            "method": "GET",
            "auth": false,
            "docs": "Recent stake/unstake/extend/claim events"
        },
        "network": {
            "method": "GET",
            "auth": false,
            "docs": "Live Starknet mainnet: block, native staking totals"
        },
        "balance": {
            "method": "GET",
            "auth": false,
            "docs": "{address, network} -> live STRK/ETH balance"
        },
        "contract": {
            "method": "GET",
            "auth": false,
            "docs": "Cairo source, deployment status, live reads"
        },
        "whitepaper": {
            "method": "GET",
            "auth": false,
            "docs": "Protocol whitepaper (markdown)"
        },
        "stake": {
            "method": "POST",
            "auth": false,
            "docs": "{owner, amount, lock_seconds|lock_days, validator?} paper stake"
        },
        "unstake": {
            "method": "POST",
            "auth": false,
            "docs": "{owner, id} withdraw principal + rewards after unlock"
        },
        "extend": {
            "method": "POST",
            "auth": false,
            "docs": "{owner, id, lock_seconds|lock_days} re-lock from now (never shorter)"
        },
        "claim": {
            "method": "POST",
            "auth": false,
            "docs": "{owner} claim all pending rewards"
        }
    },
    "fns": [
        "info",
        "stats",
        "quote",
        "account",
        "stake",
        "unstake",
        "extend",
        "claim",
        "network",
        "balance",
        "test",
        "build",
        "serve",
        "kill",
        "status"
    ],
    "schema": "QmXMUQH5feoicbYx6zSDmxxQv8xSR4sAun8efW2LVBirnN"
}