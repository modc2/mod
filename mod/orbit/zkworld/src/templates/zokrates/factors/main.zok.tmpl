// {{NAME}}: prove you know a and b with a * b == c. c is public (ZoKrates
// params are public unless `private`); neither factor may be 1, otherwise
// "1 * c" proves nothing.
def main(private field a, private field b, field c) {
    assert(a != 1);
    assert(b != 1);
    assert(a * b == c);
    return;
}
