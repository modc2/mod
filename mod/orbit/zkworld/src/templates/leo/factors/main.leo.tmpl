// {{NAME}}: prove you know a and b with a * b == c. c is public, a and b are
// private (Leo's default), and neither may be 1.
program {{PKG}}.aleo {
    @noupgrade
    constructor() {}

    fn main(a: field, b: field, public c: field) {
        assert_neq(a, 1field);
        assert_neq(b, 1field);
        assert_eq(a * b, c);
    }
}
