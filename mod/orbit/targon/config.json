{
    "name": "targon",
    "version": "1.2.0",
    "description": "Targon (Bittensor SN4) decentralized GPU compute \u2014 Rust MCP server + Game Boy console with an in-browser TAO wallet",
    "port": 50440,
    "app_port": 50440,
    "route": true,
    "urls": {
        "api": "http://localhost:50440",
        "app": "http://localhost:50440/targon",
        "mcp": "http://localhost:50440/mcp",
        "provider": "https://targon.com",
        "docs": "https://docs.targon.com"
    },
    "endpoints": {
        "console": "GET /targon (browser)",
        "mcp": "POST /mcp",
        "tools": "GET /tools",
        "forward": "POST /forward",
        "inventory": "GET /inventory",
        "cheapest": "GET /cheapest",
        "rent": "POST /rent",
        "workloads": "GET|POST /workloads",
        "workload": "GET|DELETE /workloads/:uid",
        "deploy": "POST /workloads/:uid/deploy",
        "suspend": "POST /workloads/:uid/suspend",
        "reboot": "POST /workloads/:uid/reboot",
        "exec": "POST /workloads/:uid/exec",
        "state": "GET /workloads/:uid/state",
        "logs": "GET /workloads/:uid/logs",
        "events": "GET /workloads/:uid/events",
        "vm_images": "GET /vm-images",
        "volumes": "GET|POST /volumes",
        "volume": "GET|DELETE /volumes/:uid",
        "ssh_keys": "GET|POST /ssh-keys",
        "ssh_key": "DELETE /ssh-keys/:uid",
        "templates": "GET|POST /templates",
        "template": "GET|DELETE /templates/:uid",
        "api_keys": "GET|POST /api-keys",
        "api_key": "DELETE /api-keys/:uid",
        "credits": "GET /credits",
        "wallet": "GET /wallet",
        "chain": "GET /chain",
        "chain_account": "GET /chain/account?address=",
        "chain_prepare": "POST /chain/prepare {from, to, tao}",
        "chain_submit": "POST /chain/submit {payload, signature}"
    },
    "fns": [
        "forward",
        "inventory",
        "cheapest",
        "rent",
        "workloads",
        "workload",
        "deploy",
        "suspend",
        "delete_workload",
        "state",
        "logs",
        "events",
        "exec",
        "volumes",
        "create_volume",
        "ssh_keys",
        "create_ssh_key",
        "templates",
        "credits",
        "wallet",
        "chain_account",
        "version",
        "tools",
        "mcp_call",
        "mcp_config",
        "set_api_key",
        "build",
        "serve",
        "kill",
        "test"
    ],
    "backend": "targon-rs (Rust: axum MCP server, JSON-RPC 2.0 Streamable HTTP + stdio)",
    "upstream": "https://api.targon.com/tha/v2",
    "secrets": "~/.mod/targon/api_key",
    "schema": "QmUt1AzKm7pZjZFisKBDstqj2HSkhRyhjbZEQRswm23Y6D",
    "gateway_port": 50440,
    "chain": {
        "network": "bittensor finney",
        "rpc_env": "BITTENSOR_RPC",
        "custody": "none \u2014 the browser extension signs; the server only encodes and relays"
    }
}