{
    "name": "targon",
    "version": "1.0.0",
    "description": "Targon (Bittensor SN4) decentralized GPU compute \u2014 Rust MCP server backend",
    "port": 50440,
    "route": true,
    "urls": {
        "api": "http://localhost:50440",
        "app": "http://localhost:50440"
    },
    "endpoints": {
        "mcp": "POST /mcp",
        "tools": "GET /tools",
        "forward": "POST /forward",
        "inventory": "GET /inventory",
        "cheapest": "GET /cheapest",
        "rent": "POST /rent",
        "workloads": "GET|POST /workloads",
        "workload": "GET|DELETE /workloads/:uid",
        "deploy": "POST /workloads/:uid/deploy",
        "state": "GET /workloads/:uid/state",
        "logs": "GET /workloads/:uid/logs",
        "volumes": "GET|POST /volumes",
        "ssh_keys": "GET|POST /ssh-keys",
        "templates": "GET /templates",
        "credits": "GET /credits",
        "wallet": "GET /wallet"
    },
    "fns": [
        "forward",
        "inventory",
        "cheapest",
        "rent",
        "workloads",
        "workload",
        "deploy",
        "suspend",
        "delete_workload",
        "state",
        "logs",
        "events",
        "exec",
        "volumes",
        "create_volume",
        "ssh_keys",
        "create_ssh_key",
        "templates",
        "credits",
        "wallet",
        "version",
        "tools",
        "mcp_call",
        "mcp_config",
        "set_api_key",
        "build",
        "serve",
        "kill",
        "test"
    ],
    "backend": "targon-rs (Rust: axum MCP server, JSON-RPC 2.0 Streamable HTTP + stdio)",
    "upstream": "https://api.targon.com/tha/v2",
    "secrets": "~/.mod/targon/api_key",
    "schema": "QmYY8J1cZ7UPiDfQQvxcnhAU1XZSHeeeVaE2ViJYc2jHsE",
    "gateway_port": 50440
